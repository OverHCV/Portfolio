---
import site from '../content/site.json';

import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Canonical absoluto. Descarta ?lang= a propósito: la variante ES es la misma
// página (§14 de ARCHITECTURE.md); el ruteo /es/ estático queda como follow-up.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);
const sameAs = Object.values(site.socials).filter((url): url is string => typeof url === 'string');

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: canonical.origin,
  email: `mailto:${site.email}`,
  jobTitle: site.role.en,
  sameAs,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05060a" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en" />
    <meta property="og:locale:alternate" content="es" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.role.en}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,400;1,9..144,600&family=Space+Grotesk:wght@400;500&display=swap"
    />

    <!--
      Antes del primer paint: idioma (?lang → localStorage → navegador → en) y soporte WebGL.
      Misma lógica que src/i18n/detect.ts; si cambias una, cambia la otra.
    -->
    <script is:inline>
      (function () {
        var supported = ['en', 'es'];
        var ok = function (v) { return supported.indexOf(v) >= 0; };
        var lang = new URLSearchParams(location.search).get('lang');
        if (!ok(lang)) {
          try { lang = localStorage.getItem('lang'); } catch (e) { lang = null; }
        }
        if (!ok(lang)) {
          lang = null;
          var tags = navigator.languages || [navigator.language];
          for (var i = 0; i < tags.length && !lang; i++) {
            var prefix = String(tags[i]).toLowerCase().split('-')[0];
            if (ok(prefix)) lang = prefix;
          }
        }
        var root = document.documentElement;
        root.lang = lang || 'en';

        try {
          var canvas = document.createElement('canvas');
          var gl = canvas.getContext('webgl2') || canvas.getContext('webgl');
          if (gl) {
            root.classList.add('webgl');
            var lose = gl.getExtension('WEBGL_lose_context');
            if (lose) lose.loseContext();
          }
        } catch (e) {}
      })();
    </script>

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
